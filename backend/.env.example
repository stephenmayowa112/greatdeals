# Django Configuration
DJANGO_SECRET_KEY="replace-with-a-secure-random-secret-key"
DJANGO_DEBUG="True"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"

# PostgreSQL Database Configuration
POSTGRES_DB="dealfeed"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# Redis Cache (Optional for feed caching)
REDIS_URL="redis://localhost:6379/1"

# Object Storage for Images (S3 or S3-compatible, optional)
USE_S3="False"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_STORAGE_BUCKET_NAME="your-deal-images-bucket"
AWS_S3_REGION_NAME="us-east-1"
